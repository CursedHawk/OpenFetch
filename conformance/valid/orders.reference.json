{
  "version": "1.0",
  "select": [
    "id",
    "number",
    "status",
    "total",
    "createdAt"
  ],
  "where": {
    "type": "logical",
    "operator": "and",
    "children": [
      {
        "type": "comparison",
        "field": "status",
        "operator": "in",
        "value": [
          "open",
          "processing"
        ]
      },
      {
        "type": "comparison",
        "field": "createdAt",
        "operator": "gte",
        "value": "2026-01-01T00:00:00Z"
      }
    ]
  },
  "orderBy": [
    {
      "field": "createdAt",
      "direction": "desc"
    },
    {
      "field": "id",
      "direction": "asc"
    }
  ],
  "page": {
    "first": 3
  }
}
